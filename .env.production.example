# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE DE PRODUÇÃO (NUVEM)
# ==============================================================================

APP_NAME=Financeiro
APP_ENV=production
APP_KEY=base64:gere_uma_chave_com_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://seu-app.onrender.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ── Banco de Dados (PostgreSQL na Nuvem) ──────────────────────────────────────
DB_CONNECTION=pgsql
# Se seu provedor fornecer DATABASE_URL completa (ex: Render/Railway/Supabase/Neon),
# basta preencher DATABASE_URL e deixar os outros abaixo vazios:
DATABASE_URL=
# Ou preencha individualmente:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_home
DB_USERNAME=postgres
DB_PASSWORD=

# ── Automações de Deploy ──────────────────────────────────────────────────────
# Popula o banco com todos os seus 1.458+ registros na inicialização:
SEED_ON_DEPLOY=true
# Configura o Webhook do Telegram automaticamente ao iniciar o container:
AUTO_SET_TELEGRAM_WEBHOOK=true

# ── Sessões, Cache e Filas ────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=10080
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=seu_telegram_bot_token_aqui
TELEGRAM_ALLOWED_CHAT_ID="seu_chat_id_aqui"
TELEGRAM_WEBHOOK_SECRET=seu_secret_aleatorio_aqui
TELEGRAM_USER_ID=1

# ── Google Gemini AI ──────────────────────────────────────────────────────────
GEMINI_API_KEY=sua_gemini_api_key_aqui

# ── Visualizador de Fotos (Opcional na Nuvem) ──────────────────────────────────
PHOTOS_USER=seu_usuario_aqui
PHOTOS_PASSWORD=sua_senha_segura_aqui
PHOTOS_PATH=/var/www/html/storage/photos

